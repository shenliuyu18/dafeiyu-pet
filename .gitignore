# 依赖与构建产物
node_modules/
dist/

# 开发截图与图标候选（选定后才写入 assets）
dev-shots/
icon-candidates/

# Qoder 会话产物
.qoder-credits/

# 日志
*.log

# Python 缓存
__pycache__/
*.pyc

# 打包脚本的临时配置
.build-config.json
.font-chars.txt

# Wails 构建产物（appicon.png、icon.ico、info.json、manifest 与安装脚本保留）
wails/build/bin/
wails/*.exe
wails/*-res.syso
wails/build/windows/installer/tmp/
wails/build/windows/installer/wails_tools.nsh
wails/frontend/dist/

# Wails 生成的 JS 绑定（运行时 window.go 由 Wails 注入，不使用此目录）
wails/frontend/wailsjs/

# Lite 生成素材
assets-lite/

# 角色包构建产物（体积大，不进仓库）
characters-build/
characters-build-pub/
wails/build/

# 素材转换前的原图备份（tools/optimize-assets.py --apply 生成）
.asset-backup/

# 性能预算报告（本地/CI 生成的构建产物）
perf-report.json

# 本地调试/回滚点
.qoder-backup/
glass_compare.png
glass_on_desktop.png
pet_track.png
