{
  "name": "dafeiyu-desktop-pet",
  "version": "1.5.5-beta.1",
  "description": "大肥鱼桌宠 —— 会吃白饭、会摸鱼、会记账的桌面伙伴",
  "private": true,
  "scripts": {
    "build": "node tools/wails-build.js",
    "build:lite": "node tools/wails-build.js --lite",
    "dist-install": "node tools/wails-build.js --install",
    "dist-install:lite": "node tools/wails-build.js --lite --install",
    "packs:lite": "python tools/build-character-pack-lite.py",
    "lanzou:upload": "node tools/lanzou-upload/upload.js",
    "perf:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/perf-check.ps1",
    "test:frontend": "node --test tests/*.test.js",
    "test:smoke": "node tools/renderer-smoke.js",
    "typecheck": "tsc -p jsconfig.json",
    "audit:assets": "node tools/asset-audit.js",
    "optimize:assets": "python tools/optimize-assets.py --apply"
  },
  "author": "shenliuyu",
  "devDependencies": {
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.3"
  }
}
